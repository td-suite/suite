# Variabili dei moduli travasati (facoltative: ogni modulo funziona senza, con le integrazioni esterne spente).
# Su Render: td-suite > Environment > "Add from .env". Copiare i valori dalle variabili delle app originali.

# Business (portali): la chiave con cui td-business cifra le credenziali dei portali. Senza, le credenziali travasate non si decifrano.
BUSINESS_CREDENTIALS_KEY=
# Retail: stesso SESSION_SECRET dell'app Retail (firma dei link e dei token già emessi)
RETAIL_SESSION_SECRET=
# Contratti del personale: assistente AI (usa la chiave Anthropic della Suite se non indicata)
CONTRACTS_AI_ENABLED=true
CONTRACTS_ANTHROPIC_API_KEY=
# Non conformità: StudioLAB / LIS. Nuovi indirizzi da comunicare a StudioLAB: {BASE_URL}/api/nc/hl7 e {BASE_URL}/api/nc/lis/push
LIS_BASE_URL=
LIS_API_KEY=
LIS_PUSH_SECRET=
LIS_CODICE_CLIENTE=
LIS_MITTENTE=
LIS_WRITE_BACK=false
STUDIOLAB_API_URL=
STUDIOLAB_API_KEY=
STUDIOLAB_CLIENT_CODE=
STUDIOLAB_INBOUND_KEY=
MAIL_LAB_NOTIFY=
# Ordini e Magazzino: fornitori (Silva) e chiavi API. Nuovo indirizzo: {BASE_URL}/api/orders/integrations/...
SILVA_CUSTOMER_CODE=
SILVA_INBOUND_KEY=
SILVA_ORDER_EMAIL=
# Spedizioni e Kit: casella letta via Graph e tracking corrieri
SHIPMENTS_GRAPH_INBOX=
TRACKING_PROVIDER=
TRACKING_API_KEY=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
# Cash Management
CASH_PICKUP_ALERT_DAYS=3
# Finance: firma consentita anche con credenziali locali (default: solo Microsoft 365)
SIGN_ALLOW_LOCAL=false
# Generazione PDF via LibreOffice (nell'immagine Docker: /usr/bin/soffice)
SOFFICE_BIN=/usr/bin/soffice
